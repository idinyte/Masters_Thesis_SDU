@inproceedings{10.1007/978-3-030-58147-3_32,
  author    = {Guo, X. and Zhang, Y. and Wei, W. and Xu, W. and Wang, D.},
  title     = {ThermalTex: A Two-Modal Tactile Display for Delivering Surface Texture and Thermal Information},
  year      = {2020},
